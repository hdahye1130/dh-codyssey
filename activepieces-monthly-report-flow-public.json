                  "sampleData": {},
                  "sourceCode": {
                    "code": "export const code = async (inputs) => {\n  const settingsRows = Array.isArray(inputs.settingsRows) ? inputs.settingsRows : [];\n  const calendarRows = Array.isArray(inputs.calendarRows) ? inputs.calendarRows : [];\n\n  const units = {};\n  for (const row of settingsRows) {\n    const subject = String(row?.[0] ?? \"\").trim();\n    if (!subject) continue;\n    const currentUnit = String(row?.[1] ?? \"\").trim();\n    const newUnitRaw = String(row?.[2] ?? \"\").trim();\n    units[subject] = {\n      currentUnit,\n      newUnit: newUnitRaw || currentUnit,\n    };\n  }\n\n  const calendarText = calendarRows\n    .slice(1)\n    .map((row) =>\n      Array.from({ length: 7 }, (_, i) => String(row?.[i] ?? \"\")).join(\"|||\")\n    )\n    .join(\"\");\n\n  const pattern = /(?<subject>단어|작문|독해|듣기)\\s+(?:(?<test>test)\\s*\\((?<testRange>[^)]+)\\)|(?<value>[0-9]+(?:-[0-9]+)?(?:\\s*,\\s*[0-9]+(?:-[0-9]+)?)*))(?:\\s*\\((?<status>학습시작|학습완료)\\))?/g;\n\n  const grouped = { 단어: [], 작문: [], 듣기: [], 독해: [] };\n  let match;\n  while ((match = pattern.exec(calendarText)) !== null) {\n    const g = match.groups || {};\n    if (grouped[g.subject]) {\n      grouped[g.subject].push({\n        value: g.value || \"\",\n        test: g.test || \"\",\n        testRange: g.testRange || \"\",\n        status: g.status || \"\",\n      });\n    }\n  }\n\n  const summarize = (subject) => {\n    const entries = grouped[subject] || [];\n    const values = entries.map((x) => x.value).filter((x) => x !== \"\");\n    const startValue = values.length\n      ? values[0].split(\",\")[0].trim()\n      : \"\";\n    const endValue = values.length\n      ? values[values.length - 1].split(\",\").pop().trim()\n      : \"\";\n    const testCount = entries.filter((x) => x.test !== \"\").length;\n    const completedValue =\n      entries.find((x) => x.status === \"학습완료\" && x.value)?.value || \"\";\n    const newStartValue =\n      entries.find((x) => x.status === \"학습시작\" && x.value)?.value || \"\";\n    const currentUnit = units[subject]?.currentUnit || \"\";\n    const newUnit = units[subject]?.newUnit || currentUnit;\n\n    const newRangeText =\n      newStartValue === endValue\n        ? newUnit + \" \" + newStartValue\n        : newUnit + \" \" + newStartValue + \" ~ \" + newUnit + \" \" + endValue;\n\n    let coreSummary;\n    if (!completedValue) {\n      if (!newStartValue) {\n        coreSummary =\n          currentUnit + \" \" + startValue + \" ~ \" + currentUnit + \" \" + endValue;\n      } else {\n        coreSummary = newRangeText + \" 신규 학습 시작\";\n      }\n    } else {\n      coreSummary =\n        currentUnit +\n        \" \" +\n        startValue +\n        \" ~ \" +\n        currentUnit +\n        \" \" +\n        completedValue +\n        \" 완료, 새 교재 \" +\n        newRangeText +\n        \" 학습 시작\";\n    }\n\n    return testCount === 0\n      ? coreSummary\n      : coreSummary + \" (테스트 \" + testCount + \"회)\";\n  };\n\n  return {\n    wordSummary: summarize(\"단어\"),\n    writingSummary: summarize(\"작문\"),\n    listeningSummary: summarize(\"듣기\"),\n    readingSummary: summarize(\"독해\"),\n  };\n};",
                    "packageJson": "{}"
